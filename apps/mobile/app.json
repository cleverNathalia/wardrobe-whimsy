{
  "expo": {
    "name": "Wardrobe Whimsy",
    "slug": "wardrobe-whimsy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wardrobewhimsy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wardrobewhimsy.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "scheme": "wardrobewhimsy",
    "experiments": {
      "typedRoutes": true
    }
  }
}
