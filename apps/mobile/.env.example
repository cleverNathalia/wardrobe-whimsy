# Public values only — anything EXPO_PUBLIC_ is bundled into the app.

# The same Clerk publishable key the web app uses (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY),
# so phone and web share accounts.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The deployed web app, which hosts the API the phone app calls.
EXPO_PUBLIC_API_BASE_URL=https://wardrobe-whimsy-web.vercel.app
