// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Clerk user ID
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Google OAuth. The refresh token is what lets the app act as this user
  // against their own Drive, so uploads are owned by them and use their quota.
  googleRefreshToken String?
  googleScopes       String? // space-delimited scopes actually granted
  googleConnectedAt  DateTime?

  wardrobes Wardrobe[]

  @@map("users")
}

model Wardrobe {
  id               String   @id @default(cuid())
  userId           String
  name             String
  googleFolderId   String?  // Drive folder ID; null until the app creates the folder
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clothingItems ClothingItem[]
  outfits       Outfit[]
  wearLogs      WearLog[]
  looks         Look[]
  colourCombos  ColourCombo[]
  trips         Trip[]

  @@unique([userId, googleFolderId])
  @@index([userId])
  @@map("wardrobes")
}

model ClothingItem {
  id            String   @id @default(cuid())
  wardrobeId    String
  imageFileId   String   // Google Drive file ID
  name          String
  category      String
  subcategory   String?
  colour        String?
  season        String?
  occasion      String?
  brand         String?
  size          String?
  imageSource   String   // 'manual' | 'google_photos'
  status        String   @default("ACTIVE") // 'DRAFT' | 'ACTIVE'
  notes         String?
  isFavourite   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wardrobe      Wardrobe     @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfitItems   OutfitItem[]
  tripItems     TripItem[]

  @@index([wardrobeId])
  @@map("clothing_items")
}

model Outfit {
  id               String   @id @default(cuid())
  wardrobeId       String
  name             String
  occasion         String?
  season           String?
  notes            String?
  tags             String[] // JSON array stored as text
  coverImageFileId String?  // Google Drive file ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wardrobe   Wardrobe     @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  items      OutfitItem[]
  wearLogs   WearLog[]
  looks      Look[]
  colourCombos OutfitColourCombo[]
  trips        TripOutfit[]

  @@index([wardrobeId])
  @@map("outfits")
}

model OutfitItem {
  id              String @id @default(cuid())
  outfitId        String
  clothingItemId  String
  positionX       Float
  positionY       Float
  scale           Float
  rotation        Float
  zIndex          Int

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  clothingItem ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@index([outfitId])
  @@index([clothingItemId])
  @@map("outfit_items")
}

/// A photo of the user actually wearing something — the real-world counterpart
/// to an Outfit, which is only ever a collage of item photos.
///
/// `outfitId` is optional and deliberately `SetNull` rather than `Cascade`: a
/// look is a photograph that happened, so deleting the outfit it was linked to
/// must not delete the photograph.
model Look {
  id          String   @id @default(cuid())
  wardrobeId  String
  outfitId    String?
  imageFileId String // Google Drive file ID
  imageSource String // 'manual' | 'google_photos'
  notes       String?
  wornAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wardrobe Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfit   Outfit?  @relation(fields: [outfitId], references: [id], onDelete: SetNull)

  @@index([wardrobeId])
  @@index([outfitId])
  @@map("looks")
}

model WearLog {
  id         String   @id @default(cuid())
  wardrobeId String
  outfitId   String
  wornAt     DateTime
  notes      String?

  wardrobe Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfit   Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([wardrobeId])
  @@index([outfitId])
  @@map("wear_logs")
}

/// A named palette the user builds by hand ("green, yellow, purple") and links
/// outfits to. The name is optional; an unnamed combo is labelled from its colours.
model ColourCombo {
  id         String   @id @default(cuid())
  wardrobeId String
  name       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wardrobe Wardrobe            @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  swatches ColourSwatch[]
  outfits  OutfitColourCombo[]

  @@index([wardrobeId])
  @@map("colour_combos")
}

model ColourSwatch {
  id      String  @id @default(cuid())
  comboId String
  hex     String // "#4f7942", always lowercase
  label   String? // optional, e.g. "moss"
  source  String // 'picker' | 'image' — sampled photos are not kept, only the colour
  order   Int     @default(0)

  combo ColourCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@map("colour_swatches")
}

/// Many-to-many: one combo can be worn as several outfits, and one outfit can
/// belong to more than one combo.
model OutfitColourCombo {
  outfitId String
  comboId  String

  outfit Outfit      @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  combo  ColourCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@id([outfitId, comboId])
  @@index([comboId])
  @@map("outfit_colour_combos")
}

/// A packing plan, e.g. "Italy 2026": a set of outfits whose items make the
/// packing list. Status (upcoming / now / past) is worked out from the dates,
/// not stored.
model Trip {
  id         String    @id @default(cuid())
  wardrobeId String
  name       String
  notes      String?
  startDate  DateTime? // midnight UTC, like wornAt — both dates or neither
  endDate    DateTime?
  limits     Json? // per packing group, e.g. { "top": 5, "shoes": 2 }
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  wardrobe Wardrobe     @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfits  TripOutfit[]
  items    TripItem[]

  @@index([wardrobeId])
  @@map("trips")
}

/// Many-to-many: one outfit can be packed for several trips.
model TripOutfit {
  tripId   String
  outfitId String

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  outfit Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@id([tripId, outfitId])
  @@index([outfitId])
  @@map("trip_outfits")
}

/// One item's state on a trip. A row exists only while the item was added on
/// its own (isLoose) or is ticked as packed; items that only come from outfits
/// need no row. A row that is neither is deleted rather than kept.
model TripItem {
  tripId         String
  clothingItemId String
  isLoose        Boolean   @default(false)
  packedAt       DateTime?

  trip         Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  clothingItem ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@id([tripId, clothingItemId])
  @@index([clothingItemId])
  @@map("trip_items")
}
