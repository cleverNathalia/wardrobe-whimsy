// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Clerk user ID
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Google OAuth. The refresh token is what lets the app act as this user
  // against their own Drive, so uploads are owned by them and use their quota.
  googleRefreshToken String?
  googleScopes       String? // space-delimited scopes actually granted
  googleConnectedAt  DateTime?

  wardrobes Wardrobe[]

  @@map("users")
}

model Wardrobe {
  id               String   @id @default(cuid())
  userId           String
  name             String
  googleFolderId   String?  // Drive folder ID; null until the app creates the folder
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clothingItems ClothingItem[]
  outfits       Outfit[]
  wearLogs      WearLog[]
  looks         Look[]

  @@unique([userId, googleFolderId])
  @@index([userId])
  @@map("wardrobes")
}

model ClothingItem {
  id            String   @id @default(cuid())
  wardrobeId    String
  imageFileId   String   // Google Drive file ID
  name          String
  category      String
  subcategory   String?
  colour        String?
  season        String?
  occasion      String?
  brand         String?
  size          String?
  imageSource   String   // 'manual' | 'google_photos'
  status        String   @default("ACTIVE") // 'DRAFT' | 'ACTIVE'
  notes         String?
  isFavourite   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wardrobe      Wardrobe     @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfitItems   OutfitItem[]

  @@index([wardrobeId])
  @@map("clothing_items")
}

model Outfit {
  id               String   @id @default(cuid())
  wardrobeId       String
  name             String
  occasion         String?
  season           String?
  notes            String?
  tags             String[] // JSON array stored as text
  coverImageFileId String?  // Google Drive file ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wardrobe   Wardrobe     @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  items      OutfitItem[]
  wearLogs   WearLog[]
  looks      Look[]

  @@index([wardrobeId])
  @@map("outfits")
}

model OutfitItem {
  id              String @id @default(cuid())
  outfitId        String
  clothingItemId  String
  positionX       Float
  positionY       Float
  scale           Float
  rotation        Float
  zIndex          Int

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  clothingItem ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@index([outfitId])
  @@index([clothingItemId])
  @@map("outfit_items")
}

/// A photo of the user actually wearing something — the real-world counterpart
/// to an Outfit, which is only ever a collage of item photos.
///
/// `outfitId` is optional and deliberately `SetNull` rather than `Cascade`: a
/// look is a photograph that happened, so deleting the outfit it was linked to
/// must not delete the photograph.
model Look {
  id          String   @id @default(cuid())
  wardrobeId  String
  outfitId    String?
  imageFileId String // Google Drive file ID
  imageSource String // 'manual' | 'google_photos'
  notes       String?
  wornAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wardrobe Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfit   Outfit?  @relation(fields: [outfitId], references: [id], onDelete: SetNull)

  @@index([wardrobeId])
  @@index([outfitId])
  @@map("looks")
}

model WearLog {
  id         String   @id @default(cuid())
  wardrobeId String
  outfitId   String
  wornAt     DateTime
  notes      String?

  wardrobe Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  outfit   Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([wardrobeId])
  @@index([outfitId])
  @@map("wear_logs")
}
