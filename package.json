{
  "name": "wardrobe-whimsy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo dev --filter=@wardrobe-whimsy/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "turbo": "^2.5.4"
  }
}
